# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The site's public address (used for social images and the sitemap), e.g. https://ecobytes.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random string; use the same value as the secret in the Prismic webhook.
PRISMIC_WEBHOOK_SECRET=

# Only needed if the Prismic repository's API is set to private.
PRISMIC_ACCESS_TOKEN=

# Only for `npm run seed`: a write token from Prismic → Settings → API & Security → Write APIs.
PRISMIC_WRITE_TOKEN=
