{
  "id": "article",
  "label": "Article",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug",
          "placeholder": "e.g. green-computing-101"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "Article title",
          "single": "heading1"
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Summary",
          "placeholder": "One or two sentences shown on cards and in search results"
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured image",
          "constraint": {
            "width": 1600,
            "height": 900
          },
          "thumbnails": []
        }
      },
      "publication_date": {
        "type": "Date",
        "config": {
          "label": "Publication date",
          "placeholder": "Used to sort articles (newest first)"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "placeholder": "Pick a category",
          "options": [
            "Green computing",
            "Eco-friendly gadgets",
            "Sustainable tech trends"
          ],
          "default_value": "Sustainable tech trends"
        }
      },
      "author": {
        "type": "Text",
        "config": {
          "label": "Author",
          "placeholder": "Who wrote it"
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured on the homepage",
          "default_value": false,
          "placeholder_true": "Featured",
          "placeholder_false": "Not featured"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "text": {
              "type": "SharedSlice"
            },
            "image_block": {
              "type": "SharedSlice"
            },
            "embed": {
              "type": "SharedSlice"
            },
            "quote": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": "Shown in the browser tab and search results (falls back to the title)"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": "One or two sentences for search results (falls back to the summary)"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {
            "width": 1200,
            "height": 630
          },
          "thumbnails": []
        }
      }
    }
  }
}
